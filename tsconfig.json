{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2021",
		"strict": false,
		"noImplicitAny": false,
		"moduleResolution": "node",
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		"lib": [
			"ES2021",
			"DOM"
		]
	},
	"include": [
		"main.ts",
		"src/**/*.ts"
	]
}